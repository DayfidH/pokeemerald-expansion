const LOCALID_LADY = 1 // Replace 1 with the Object Event ID of the NPC from Porymap
const LOCALID_KNOWITALL = 4

// --------------------------------------------------
// Map Scripts
// --------------------------------------------------
mapscripts HiddenVillage_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: HiddenVillage_OnTransition
}

script HiddenVillage_OnTransition {
    switch (var(VAR_HIDDEN_VILLAGE_STATE)) {
        case 1: 
            setobjectxyperm(LOCALID_LADY, 14, 14)
            setobjectmovementtype(LOCALID_LADY, MOVEMENT_TYPE_LOOK_AROUND)
            
        case 2: 
            setflag(FLAG_TEMP_2)
            setobjectxyperm(LOCALID_LADY, 17, 5)
            setobjectmovementtype(LOCALID_LADY, MOVEMENT_TYPE_FACE_DOWN)
            setobjectxyperm(LOCALID_KNOWITALL, 11, 11)
    }
}

script HiddenVillage_EventScript_DefaultText {
    lock
    faceplayer
    msgbox(format("Hi {PLAYER}!"))
    setvar(VAR_HIDDEN_VILLAGE_STATE, 2)
    release
    end
}

script HiddenVillage_EventScript_ClimbTheVine {
    lock
    faceplayer
    msgbox(format("Hey {PLAYER}! Do you remember how to get into the treehouse? Just climb the vine like this!"))
    closemessage

    applymovement(LOCALID_KNOWITALL, Movement_ClimbTheVine)
    waitmovement(0)
    removeobject(LOCALID_KNOWITALL)
    setflag(FLAG_TEMP_3)
    release
    end
}

movement Movement_ClimbTheVine {
    walk_right * 2
    walk_slow_up
}

// --------------------------------------------------
// Main NPC Interaction Script
// --------------------------------------------------
script HiddenVillage_EventScript_Lady {
    lock
    faceplayer
    
    switch (var(VAR_HIDDEN_VILLAGE_STATE)) {
        case 0:
            msgbox(format("{PLAYER}! You're going to be late! Hurry up and see the Village Elder..."))
            closemessage
            applymovement(LOCALID_LADY, Common_Movement_FaceDown)
            waitmovement(0)
            
        case 1: 
            msgbox(format("The Elder asked for help keeping an eye on you kids!"))
        //Split into a talk to script and into a trigger script, the trigger moves the player down when finished, talking to the npc does not
        case 2: 
            msgbox(format("H-hey! There's nothing past here... Weren't you going to see your friends at the Tree House? It's right over there!"))
            special(SpawnCameraObject)
            applymovement(OBJ_EVENT_ID_CAMERA, Movement_CameraPanLeftAndDown)
            waitmovement(0)
            msgbox(format("You can climb up it using the vine!"))
            closemessage
            applymovement(OBJ_EVENT_ID_CAMERA, Movement_CameraPanRightAndUp)
            waitmovement(0)
            special(RemoveCameraObject)
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
            waitmovement(0)
            
    }
    release
    end
}

// --------------------------------------------------
// Trigger Scripts (Optimized)
// --------------------------------------------------

// Assign to the trigger tile on the LEFT of the NPC
script HiddenVillage_EventScript_LateTriggerLeft {
    lockall
    applymovement(LOCALID_LADY, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_LADY, Common_Movement_FaceLeft)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    waitmovement(0)
    
    call(HiddenVillage_EventScript_LateTriggerMain)
    
    releaseall
    end
}

// Assign to the trigger tile on the RIGHT of the NPC
script HiddenVillage_EventScript_LateTriggerRight {
    lockall
    applymovement(LOCALID_LADY, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_LADY, Common_Movement_FaceRight)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    waitmovement(0)
    
    call(HiddenVillage_EventScript_LateTriggerMain)
    
    releaseall
    end
}

// The shared event
script HiddenVillage_EventScript_LateTriggerMain {
    msgbox(format("{PLAYER}! You're going to be late! Hurry up and see the Village Elder..."))
    closemessage
    
    // NPC faces down, Player is pushed away using built-in common movement
    applymovement(LOCALID_LADY, Common_Movement_FaceDown)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
    
    waitmovement(0) 
    return 
}

movement Movement_CameraPanLeftAndDown {
    walk_slow_left * 4
    walk_slow_down * 4
}

movement Movement_CameraPanRightAndUp {
    walk_slow_up *4
    walk_slow_right * 4
}